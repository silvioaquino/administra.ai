model CaixaAbertura {
  id            String           @id @default(uuid())
  empresaId     String           @map("empresa_id")
  userId        String           @map("user_id")
  dataAbertura  DateTime         @default(now())
  valorInicial  Float
  observacao    String?
  status        String           @default("ABERTO")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fechamento    CaixaFechamento?
  retiradas     Retirada[]
  vendas        Venda[]
  vendasManuais VendaManual[]

  @@index([status])
  @@index([dataAbertura])
  @@index([empresaId])
  @@map("caixa_abertura")
}

model Venda {
  id              String         @id @default(uuid())
  empresaId       String         @map("empresa_id")
  userId          String         @map("user_id")
  dataVenda       DateTime       @default(now())
  dadosPedido     Json
  tipoPagamento   String         @default("PENDENTE")
  valorTotal      Float
  manual          Boolean        @default(false)
  caixaAberturaId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  nomeCliente     String?
  telefoneCliente String?
  tipoPedido      String?
  endereco        String?
  numeroPedido    String?        @unique
  produtos        ProdutoVenda[]
  caixaAbertura   CaixaAbertura  @relation(fields: [caixaAberturaId], references: [id])
  empresa         Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dataVenda])
  @@index([caixaAberturaId])
  @@index([tipoPagamento])
  @@index([nomeCliente])
  @@index([tipoPedido])
  @@index([numeroPedido])
  @@index([empresaId])
  @@map("vendas")
}

model ProdutoVenda {
  id         String   @id @default(uuid())
