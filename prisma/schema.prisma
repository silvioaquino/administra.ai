generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String                            @id @default(cuid())
  email                           String                            @unique
  passwordHash                    String?
  name                            String?
  trialEndsAt                     DateTime?
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  resetToken                      String?                           @unique
  resetTokenExpiry                DateTime?
  boletos                         Boleto[]
  caixasAbertura                  CaixaAbertura[]
  caixasFechamento                CaixaFechamento[]
  categorias                      Categoria[]
  contasFinanceiras               ContaFinanceira[]
  despesasFixas                   DespesaFixa[]
  despesasVariaveis               DespesaVariavel[]
  despesasVariaveisResultados     DespesasVariaveisResultado[]
  dreResultados                   DreResultado[]
  empresas                        Empresa[]
  fechamentoMensal                FechamentoMensal[]
  fichasItens                     FichaItem[]
  fichasTecnicas                  FichaTecnica[]
  fluxoCaixaDiario                FluxoCaixaDiario[]
  funcionarios                    Funcionario[]
  livroDiario                     LivroDiario[]
  metasFluxoCaixa                 MetaFluxoCaixa[]
  notasFiscais                    NotaFiscal[]
  pagamentos                      Pagamento[]
  planejamentoAcompanhamento      PlanejamentoAcompanhamento[]
  planejamentoAcompanhamentoNovo  PlanejamentoAcompanhamentoNovo[]
  planejamentoConfig              PlanejamentoConfig[]
  planejamentoDespesaFixaNovo     PlanejamentoDespesaFixaNovo[]
  planejamentoDespesaVariavelNovo PlanejamentoDespesaVariavelNovo[]
  planejamentoFaturamento         PlanejamentoFaturamento[]
  planejamentoFaturamentoNovo     PlanejamentoFaturamentoNovo[]
  planejamentoFolhaSalarial       PlanejamentoFolhaSalarial[]
  planoContas                     PlanoContas[]
  produtosVenda                   ProdutoVenda[]
  produtos                        Produto[]
  provisoesFuncionarios           ProvisaoFuncionario[]
  folhaPagamentoConfig           FolhaPagamentoConfig[]
  retiradas                       Retirada[]
  subscription                    Subscription?
  taxasCartaoConfig               TaxasCartaoConfig?
  vendas                          Venda[]
  vendasManuais                   VendaManual[]

  @@map("users")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  planId    String
  status    String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  plan      Plan      @relation(fields: [planId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  price         Float
  features      Json
  isActive      Boolean        @default(true)
  stripePriceId String?
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]

  @@map("plans")
}

model Empresa {
  id                              String                            @id @default(cuid())
  userId                          String
  nome                            String?
  whatsapp                        String?
  segmento                        String?
  cep                             String?
  logradouro                      String?
  numero                          String?
  complemento                     String?
  bairro                          String?
  cidade                          String?
  estado                          String?
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  boletos                         Boleto[]
  caixasAbertura                  CaixaAbertura[]
  caixasFechamento                CaixaFechamento[]
  categorias                      Categoria[]
  contasFinanceiras               ContaFinanceira[]
  despesasFixas                   DespesaFixa[]
  despesasVariaveis               DespesaVariavel[]
  despesasVariaveisResultados     DespesasVariaveisResultado[]
  dreResultados                   DreResultado[]
  user                            User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  folhaPagamentoConfig           FolhaPagamentoConfig[]
  fechamentoMensal                FechamentoMensal[]
  fichasItens                     FichaItem[]
  fichasTecnicas                  FichaTecnica[]
  fluxoCaixaDiario                FluxoCaixaDiario[]
  funcionarios                    Funcionario[]
  livroDiario                     LivroDiario[]
  metasFluxoCaixa                 MetaFluxoCaixa[]
  notasFiscais                    NotaFiscal[]
  pagamentos                      Pagamento[]
  planejamentoAcompanhamento      PlanejamentoAcompanhamento[]
  planejamentoAcompanhamentoNovo  PlanejamentoAcompanhamentoNovo[]
  planejamentoConfig              PlanejamentoConfig[]
  planejamentoDespesaFixaNovo     PlanejamentoDespesaFixaNovo[]
  planejamentoDespesaVariavelNovo PlanejamentoDespesaVariavelNovo[]
  planejamentoFaturamento         PlanejamentoFaturamento[]
  planejamentoFaturamentoNovo     PlanejamentoFaturamentoNovo[]
  planejamentoFolhaSalarial       PlanejamentoFolhaSalarial[]
  planoContas                     PlanoContas[]
  produtosVenda                   ProdutoVenda[]
  produtos                        Produto[]
  provisoesFuncionarios           ProvisaoFuncionario[]
  retiradas                       Retirada[]
  taxasCartaoConfig               TaxasCartaoConfig?
  vendas                          Venda[]
  vendasManuais                   VendaManual[]

  @@map("empresas")
}

model ContaFinanceira {
  id            Int           @id @default(autoincrement())
  empresaId     String        @map("empresa_id")
  userId        String        @map("user_id")
  nome          String
  tipo          String
  saldoInicial  Decimal       @default(0) @map("saldo_inicial") @db.Decimal(10, 2)
  instituicao   String?
  isDefault     Boolean       @default(false) @map("is_default")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  despesasFixas DespesaFixa[]

  @@unique([nome, empresaId])
  @@index([empresaId])
  @@map("contas_financeiras")
}

model NotaFiscal {
  id               Int           @id @default(autoincrement())
  userId           String
  chaveAcesso      String        @unique @map("chave_acesso")
  numero           Int
  serie            Int           @default(1)
  dataEmissao      DateTime      @map("data_emissao")
  cnpjEmitente     String        @map("cnpj_emitente")
  nomeEmitente     String        @map("nome_emitente")
  ieEmitente       String?       @map("ie_emitente")
  enderecoEmitente String?       @map("endereco_emitente")
  valorTotal       Decimal       @map("valor_total") @db.Decimal(10, 2)
  cpfConsumidor    String?       @map("cpf_consumidor")
  createdAt        DateTime      @default(now()) @map("created_at")
  empresaId        String
  livroDiario      LivroDiario[]
  empresa          Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pagamentos       Pagamento[]
  produtos         Produto[]

  @@index([userId, chaveAcesso])
  @@index([dataEmissao])
  @@index([empresaId])
  @@map("notas_fiscais")
}

model Produto {
  id             Int         @id @default(autoincrement())
  userId         String
  notaFiscalId   Int?        @map("nota_fiscal_id")
  chaveAcesso    String?     @map("chave_acesso")
  codigo         String?
  descricao      String
  unidade        String?     @default("UN")
  quantidade     Decimal?    @db.Decimal(10, 3)
  valorUnitario  Decimal?    @map("valor_unitario") @db.Decimal(10, 2)
  valorTotal     Decimal?    @map("valor_total") @db.Decimal(10, 2)
  fornecedor     String?
  dataCompra     DateTime?   @map("data_compra")
  precoVenda     Decimal?    @default(0) @map("preco_venda") @db.Decimal(10, 2)
  pesoUnitario   Decimal?    @map("peso_unitario") @db.Decimal(10, 3)
  densidade      Decimal?    @default(1) @db.Decimal(5, 3)
  createdAt      DateTime    @default(now()) @map("created_at")
  empresaId      String
  formaPagamento String?     @map("forma_pagamento")
  codigoBarras      String?   @map("codigo_barras")
  nomeNormalizado  String?   @map("nome_normalizado")
  marca            String?
  categoriaSugestao String?   @map("categoria_sugestao")
  unidadeMedida    String?   @map("unidade_medida")
  fonteDados       String    @default("NORMALIZACAO_LOCAL") @map("fonte_dados")
  precisaRevisao   Boolean   @default(false) @map("precisa_revisao")
  normalizadoEm    DateTime? @map("normalizado_em")
  itensFicha     FichaItem[]
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  notaFiscal     NotaFiscal? @relation(fields: [notaFiscalId], references: [id])
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, descricao])
  @@index([empresaId])
  @@index([notaFiscalId])
  @@index([empresaId, codigoBarras])
  @@index([empresaId, nomeNormalizado])
  @@index([empresaId, fonteDados])
  @@index([empresaId, precisaRevisao])
  @@map("produtos")
}

model Pagamento {
  id             Int        @id @default(autoincrement())
  userId         String
  notaFiscalId   Int        @map("nota_fiscal_id")
  formaPagamento String     @map("forma_pagamento")
  valor          Decimal    @db.Decimal(10, 2)
  empresaId      String
  empresa        Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  notaFiscal     NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([empresaId])
  @@map("pagamentos")
}

model LivroDiario {
  id                Int         @id @default(autoincrement())
  userId            String
  data              DateTime
  conta             String
  descricao         String
  clienteFornecedor String?     @map("cliente_fornecedor")
  entrada           Decimal     @default(0) @db.Decimal(10, 2)
  saida             Decimal     @default(0) @db.Decimal(10, 2)
  tipo              String      @default("VENDA")
  notaFiscalId      Int?        @map("nota_fiscal_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  empresaId         String
  origemDestino     String?     @map("origem_destino")
  status            String      @default("PENDENTE")
  dataPagamento     DateTime?   @map("data_pagamento")
  boletos           Boleto[]
  empresa           Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  notaFiscal        NotaFiscal? @relation(fields: [notaFiscalId], references: [id])
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, data])
  @@index([userId, conta])
  @@index([userId, tipo])
  @@index([userId, origemDestino])
  @@index([userId, status])
  @@index([empresaId])
  @@map("livro_diario")
}

model PlanejamentoConfig {
  id            Int      @id @default(autoincrement())
  userId        String
  tipo          String
  dados         Json
  anoReferencia Int      @map("ano_referencia")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, tipo, anoReferencia])
  @@index([userId, tipo, anoReferencia])
  @@index([empresaId])
  @@map("planejamento_config")
}

model PlanejamentoFaturamento {
  id               Int      @id @default(autoincrement())
  userId           String
  ano              Int
  mes              Int
  metaDiariaAlmoco Float    @default(0) @map("meta_diaria_almoco")
  metaDiariaJanta  Float    @default(0) @map("meta_diaria_janta")
  diasTrabalhados  Int      @default(26) @map("dias_trabalhados")
  lucroDesejado    Float    @default(15)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, ano, mes])
  @@index([userId, ano, mes])
  @@index([empresaId])
  @@map("planejamento_faturamento")
}

model PlanejamentoAcompanhamento {
  id                Int      @id @default(autoincrement())
  userId            String
  ano               Int
  mes               Int
  faturamentoAlmoco Float    @default(0) @map("faturamento_almoco")
  faturamentoJanta  Float    @default(0) @map("faturamento_janta")
  faturamentoTotal  Float    @default(0) @map("faturamento_total")
  observacao        String?
  updatedAt         DateTime @updatedAt @map("updated_at")
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, ano, mes])
  @@index([userId, ano, mes])
  @@index([empresaId])
  @@map("planejamento_acompanhamento")
}

model FichaTecnica {
  id                String      @id @default(cuid())
  userId            String
  nome              String
  categoria         String
  precoVenda        Decimal     @default(0) @map("preco_venda") @db.Decimal(10, 2)
  custoTotal        Decimal     @default(0) @map("custo_total") @db.Decimal(10, 2)
  custoPorPorcao    Decimal     @default(0) @map("custo_por_porcao") @db.Decimal(10, 2)
  margem            Decimal     @default(0) @db.Decimal(5, 2)
  rendimentoPorcoes Int         @default(1) @map("rendimento_porcoes")
  ingredientes      String?
  modoPreparo       String?     @map("modo_preparo")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  empresaId         String
  fichaItems        FichaItem[]
  empresa           Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nome])
  @@index([userId, categoria])
  @@index([empresaId])
  @@map("fichas_tecnicas")
}

model FichaItem {
  id               String       @id @default(cuid())
  fichaId          String       @map("ficha_id")
  produtoId        Int          @map("produto_id")
  quantidade       Float
  unidade          String?      @default("UN")
  valorUnitario    Decimal?     @map("valor_unitario") @db.Decimal(10, 2)
  custo            Decimal?     @db.Decimal(10, 2)
  isProdutoAcabado Boolean      @default(false) @map("is_produto_acabado")
  gramasEquivalentes Float?      @map("gramas_equivalentes")
  empresaId        String
  userId           String
  empresa          Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ficha            FichaTecnica @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  produto          Produto      @relation(fields: [produtoId], references: [id])
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fichaId])
  @@index([produtoId])
  @@index([empresaId])
  @@map("ficha_itens")
}

model DespesaFixa {
  id         Int              @id @default(autoincrement())
  userId     String
  nome       String
  valor      Decimal          @db.Decimal(10, 2)
  ordem      Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  contaId    Int?             @map("conta_id")
  empresaId  String
  status     String           @default("PENDENTE")
  vencimento DateTime
  conta      ContaFinanceira? @relation(fields: [contaId], references: [id])
  empresa    Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, nome])
  @@index([userId])
  @@index([empresaId])
  @@map("despesas_fixas")
}

model DistribuicaoLucro {
  id                Int      @id @default(autoincrement())
  empresaId         String   @map("empresa_id")
  userId            String   @map("user_id")
  fechamentoMensalId Int?    @map("fechamento_mensal_id")
  ano               Int
  mes               Int
  nome              String
  percentual        Decimal  @db.Decimal(5, 2)
  valor             Decimal  @db.Decimal(10, 2)
  contaId           Int?     @map("conta_id")
  pago              Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([empresaId, ano, mes])
  @@map("distribuicoes_lucro")
}

model DespesaVariavel {
  id         Int      @id @default(autoincrement())
  userId     String
  nome       String
  percentual Float
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  empresaId  String
  aluguel    Float    @default(0)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, nome])
  @@index([userId])
  @@index([empresaId])
  @@map("despesas_variaveis")
}

model Funcionario {
  id        Int      @id @default(autoincrement())
  userId    String
  nome      String
  salario   Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, nome])
  @@index([userId])
  @@index([empresaId])
  @@map("funcionarios")
}

model FolhaPagamentoConfig {
  id                      Int      @id @default(autoincrement())
  empresaId               String   @map("empresa_id")
  userId                  String   @map("user_id")
  ano                     Int
  mes                     Int
  diaAdiantamento        Int      @default(15) @map("dia_adiantamento")
  percentualAdiantamento Decimal  @default(40) @db.Decimal(5, 2) @map("percentual_adiantamento")
  diaSalario              Int      @default(5)  @map("dia_salario")
  totalSalarios           Decimal  @default(0)  @db.Decimal(10, 2) @map("total_salarios")
  valorAdiantamento      Decimal  @default(0)  @db.Decimal(10, 2) @map("valor_adiantamento")
  valorSalario            Decimal  @default(0)  @db.Decimal(10, 2) @map("valor_salario")
  funcionariosSnapshot   Json?    @map("funcionarios_snapshot")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  empresa                 Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, ano, mes])
  @@index([empresaId, ano, mes])
  @@map("folha_pagamento_config")
}

model TaxasCartaoConfig {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  empresaId String   @unique
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("taxas_cartao_config")
}

model ProvisaoFuncionario {
  id              Int      @id @default(autoincrement())
  userId          String
  ano             Int
  provisao        String
  funcionarioNome String   @map("funcionario_nome")
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, ano, provisao, funcionarioNome])
  @@index([userId, ano, provisao])
  @@index([empresaId])
  @@map("provisoes_funcionarios")
}

model MetaFluxoCaixa {
  id                    Int      @id @default(autoincrement())
  empresaId             String   @map("empresa_id")
  userId                String   @map("user_id")
  ano                   Int
  mes                   Int
  metaFaturamentoDiaria Decimal  @default(0) @map("meta_faturamento_diaria") @db.Decimal(10, 2)
  metaDespesasDiaria    Decimal  @default(0) @map("meta_despesas_diaria") @db.Decimal(10, 2)
  metaLucroPercentual   Float    @default(20) @map("meta_lucro_percentual")
  diasUteis             Int      @default(30) @map("dias_uteis")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, ano, mes])
  @@index([userId, ano, mes])
  @@index([empresaId])
  @@map("metas_fluxo_caixa")
}

model FluxoCaixaDiario {
  id                   Int      @id @default(autoincrement())
  empresaId            String   @map("empresa_id")
  userId               String   @map("user_id")
  data                 DateTime
  faturamentoRealizado Decimal  @default(0) @map("faturamento_realizado") @db.Decimal(10, 2)
  despesasRealizadas   Decimal  @default(0) @map("despesas_realizadas") @db.Decimal(10, 2)
  lucroRealizado       Decimal  @default(0) @map("lucro_realizado") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, data])
  @@index([userId, data])
  @@index([empresaId])
  @@map("fluxo_caixa_diario")
}

model PlanoContas {
  id        Int      @id @default(autoincrement())
  empresaId String   @map("empresa_id")
  userId    String   @map("user_id")
  codigo    String
  nome      String
  tipo      String
  grupo     String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId, codigo])
  @@index([userId, tipo, grupo])
  @@index([empresaId])
  @@map("plano_contas")
}

