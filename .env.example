# ===== PRODUÇÃO =====
# Copie este arquivo e preencha com valores reais

# Database (NeonDB)
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="chave-secreta-gerada-aleatoriamente-32-chars"
NEXTAUTH_URL="https://seu-projeto.vercel.app"

# Stripe (produção - obter após deploy)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Kaiup Software <noreply@seugerente.com.br>"

# ===== STAGING =====
# Mesmas variáveis acima, mas com:
# - NEXTAUTH_URL=https://seu-projeto-staging.vercel.app
# - STRIPE_SECRET_KEY=sk_test_... (test keys)
# - Database separado para staging

# Como gerar NEXTAUTH_SECRET:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ===== Open Food Facts (normalização de produtos) =====
OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/api/v2
# IMPORTANTE: a Open Food Facts EXIGE um User-Agent identificando o app + um
# email de contato REAL. Placeholder generico gera 429 (rate limit) agressivo.
# Ex.: AdministraAi/1.0 (seu-email@provedor.com)
OPEN_FOOD_FACTS_USER_AGENT=SeuGerente/1.0 (contato@seugerente.com.br)
OPEN_FOOD_FACTS_TIMEOUT=5000
OPEN_FOOD_FACTS_RETRY_ATTEMPTS=3
# Cache (in-memory nesta fase; REDIS_URL opcional p/ troca futura)
CACHE_TTL_PRODUCT=86400
CACHE_TTL_NORMALIZATION=604800
# Features
ENABLE_OPEN_FOOD_FACTS=true
ENABLE_AUTO_CATEGORIZATION=true